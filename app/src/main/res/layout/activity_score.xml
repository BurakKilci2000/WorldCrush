<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏆 Skor Tablosu"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#16213e"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTotalGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toplam Oyun: 0"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En Yüksek Puan: 0"
            android:textColor="#e94560"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvAvgScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ortalama Puan: 0"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvTotalWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toplam Kelime: 0"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvLongestWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En Uzun Kelime: -"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toplam Süre: 0 saat 0 dakika"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:padding="4dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 Oyun Geçmişi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGames"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>