<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16213e"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Puan: 0"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvMoves"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hamle: 20"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kelime: 0"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvCurrentWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnJokerFish"
                style="@style/JokerGameButton"
                android:text="🐟\n0"/>

            <Button
                android:id="@+id/btnJokerWheel"
                style="@style/JokerGameButton"
                android:text="🎯\n0"/>

            <Button
                android:id="@+id/btnJokerLollipop"
                style="@style/JokerGameButton"
                android:text="🍭\n0"/>

            <Button
                android:id="@+id/btnJokerSwap"
                style="@style/JokerGameButton"
                android:text="✋\n0"/>

            <Button
                android:id="@+id/btnJokerShuffle"
                style="@style/JokerGameButton"
                android:text="🎲\n0"/>

            <Button
                android:id="@+id/btnJokerParty"
                style="@style/JokerGameButton"
                android:text="🎉\n0"/>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>